{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (with built jar)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build",
      "env": {
        "DETEKT_LSP_DEV_JAR": "${workspaceFolder}/../../../server/lsp-server-app/build/libs/detekt-lsp-all.jar"
      }
    }
  ]
}
